library(ggplot2)
library(dplyr)
# Read and combine all families
dat <- lapply(families, function(fam) {
f <- read.table(paste0(data_fp, "divergence_length_", fam, ".txt"),
header=FALSE,
col.names=c("divergence", "length", "location"))
f$family <- fam
f
}) %>% bind_rows()
families <- c("185", "530", "1940", "9269", "13051")
data_fp <- "~/Dropbox/research/Isch_comp/output/prelim/TEs/"
# Read and combine all families
dat <- lapply(families, function(fam) {
f <- read.table(paste0(data_fp, "divergence_length_", fam, ".txt"),
header=FALSE,
col.names=c("divergence", "length", "location"))
f$family <- fam
f
}) %>% bind_rows()
# Filter short fragments — adjust threshold based on consensus lengths
dat_filtered <- dat %>% filter(length > 500)
head(data_filtered)
head(dat_filtered)
# Plot divergence distributions per family, locus vs genome
ggplot(dat_filtered, aes(x=divergence, fill=location)) +
geom_histogram(aes(y=..density..), bins=30,
alpha=0.6, position="identity") +
facet_wrap(~family, scales="free_y") +
scale_fill_manual(values=c("genome"="steelblue", "locus"="firebrick")) +
theme_bw() +
labs(x="Kimura divergence (%)",
y="Density",
title="Copy divergence: locus vs genome-wide")
# Also plot as empirical CDFs which are cleaner for small locus sample sizes
ggplot(dat_filtered, aes(x=divergence, color=location)) +
stat_ecdf() +
facet_wrap(~family) +
scale_color_manual(values=c("genome"="steelblue", "locus"="firebrick")) +
theme_bw()
