Pa_post_long <- Pa_post %>% select(Iteration,
Replicate_ID,
rate_gain_A_when_B0:rate_gain_B_when_A1) %>% pivot_longer(
cols = rate_gain_A_when_B0:rate_gain_B_when_A1,
names_to = "rate",
values_to = "value"
) %>% separate_wider_delim(
cols = rate,
delim = "_",
names = c("blah", "type", "trait", "blah2", "condition")
) %>% select(!contains("blah")) %>% mutate(trait = factor(
trait,
levels = c("A", "B"),
labels = c("Discal", "Marginal")
)) %>% mutate(condition = factor(
condition,
levels = c("A0", "A1", "B0", "B1"),
labels = c(
"Discal_absent",
"Discal_present",
"Marginal_absent",
"Marginal_present"
)
)) %>% separate_wider_delim(
cols = condition,
delim = "_",
names = c("condition_trait", "condition")
) %>%
mutate(condtion_combined = paste0(condition_trait, condition))
PR1 <- ggplot(Pa_post_long, aes(x = value, fill = condition_combined)) +
geom_histogram(bins = 60, position = "identity", alpha = 0.7, color = "white",  linewidth = 0.2) +
facet_grid(cols = vars(trait)) +
theme_light(base_size = 8) +
theme(panel.grid = element_blank()) +
labs(x = "Transition rate", y = "Posterior frequency") +
scale_fill_manual(
values = pal[c(4, 1, 4, 2)], name = "Pre-existing eyespot")
